FROM python:3.12-slim

# Чтобы логи (print) сразу появлялись в консоли, а не буферизировались
ENV PYTHONUNBUFFERED=1
# Добавляем текущую папку в Python path, чтобы импорты models и utils работали корректно
ENV PYTHONPATH=/app

WORKDIR /app

# Копируем зависимости и устанавливаем их (без кэша pip для экономии места)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем код
COPY bot.py .
COPY models/ ./models/
COPY utils/ ./utils/

# Запускаем (исправлена опечатка в конце строки)
CMD ["python", "bot.py"]