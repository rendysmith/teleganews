# Dockerfile.bot (оптимизированный)
FROM python:3.12-slim

WORKDIR /app

# Копируем зависимости сначала (для кэширования)
COPY requirements.txt .
RUN pip install -r requirements.txt

# Копируем только нужные файлы
COPY bot.py .
COPY models/ ./models/
COPY utils/ ./utils/

ENV PYTHONPATH=/app

CMD ["python", "bot.py"]y"]